# Копирај ја оваа датотека како .env (само на твојот компјутер – .env НЕ оди на GitHub).
# На Render истите вредности се внесуваат во Environment, не во датотека.

# Линк од MongoDB Atlas (Connect → Drivers). Без него страната работи со локални датотеки.
MONGODB_URI=

# Мејл известувања за нови нарачки (опционално).
# За Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=твојата Gmail адреса,
# SMTP_PASS=„App Password“ (Google профил → Безбедност → 2-Step Verification → App passwords), НЕ обичната лозинка.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
